{
  "properties": [
    {
      "name": "sloth.doc.enabled",
      "type": "java.lang.Boolean",
      "defaultValue": true,
      "description": "Whether to enable API documentation."
    },
    {
      "name": "sloth.doc.title",
      "type": "java.lang.String",
      "defaultValue": "Sloth Boot API",
      "description": "API title."
    },
    {
      "name": "sloth.doc.description",
      "type": "java.lang.String",
      "defaultValue": "Sloth Boot 接口文档",
      "description": "API description."
    },
    {
      "name": "sloth.doc.version",
      "type": "java.lang.String",
      "defaultValue": "1.0.0",
      "description": "API version."
    },
    {
      "name": "sloth.doc.contact-name",
      "type": "java.lang.String",
      "description": "Contact name."
    },
    {
      "name": "sloth.doc.contact-email",
      "type": "java.lang.String",
      "description": "Contact email."
    },
    {
      "name": "sloth.doc.contact-url",
      "type": "java.lang.String",
      "description": "Contact url."
    },
    {
      "name": "sloth.doc.license",
      "type": "java.lang.String",
      "defaultValue": "Apache 2.0",
      "description": "License name."
    },
    {
      "name": "sloth.doc.security-scheme-enabled",
      "type": "java.lang.Boolean",
      "defaultValue": true,
      "description": "是否启用 Bearer Token 安全方案（Swagger UI 显示锁图标）。"
    },
    {
      "name": "sloth.doc.security-scheme-name",
      "type": "java.lang.String",
      "defaultValue": "Bearer",
      "description": "安全方案名称。"
    },
    {
      "name": "sloth.doc.security-bearer-format",
      "type": "java.lang.String",
      "defaultValue": "JWT",
      "description": "Bearer Token 格式。"
    },
    {
      "name": "sloth.doc.server-url",
      "type": "java.lang.String",
      "description": "服务器地址（不配置则自动检测）。"
    },
    {
      "name": "sloth.doc.server-description",
      "type": "java.lang.String",
      "defaultValue": "默认服务器",
      "description": "服务器描述。"
    }
  ]
}
