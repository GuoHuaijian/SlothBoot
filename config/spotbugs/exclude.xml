<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
    <!-- 排除 Lombok 生成的代码 -->
    <Match>
        <Source name="~.*\$.*"/>
    </Match>

    <!-- 全局排除 EI_EXPOSE_REP / EI_EXPOSE_REP2 -- Spring 项目普遍存储可变对象引用 -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
    </Match>

    <!-- 排除测试代码 -->
    <Match>
        <Class name="~.*Test$"/>
    </Match>
    <Match>
        <Class name="~.*Tests$"/>
    </Match>
    <Match>
        <Class name="~.*Test\$.*"/>
    </Match>

    <!-- AbstractDecorator: 构造器参数校验抛异常是设计意图 -->
    <Match>
        <Bug pattern="CT_CONSTRUCTOR_THROW"/>
        <Class name="com.sloth.boot.common.decorator.AbstractDecorator"/>
    </Match>

    <!-- JsonUtil: 共享 ObjectMapper 单例是有意为之 -->
    <Match>
        <Bug pattern="MS_EXPOSE_REP"/>
        <Class name="com.sloth.boot.common.util.JsonUtil"/>
    </Match>

    <!-- Spring ApplicationContext 持有者: 写入 static 字段是标准模式 -->
    <Match>
        <Bug pattern="ST_WRITE_TO_STATIC_FROM_INSTANCE_METHOD"/>
    </Match>

    <!-- TemplateUtil: 模板属性访问需要宽泛异常捕获 -->
    <Match>
        <Bug pattern="REC_CATCH_EXCEPTION"/>
        <Class name="com.sloth.boot.common.util.TemplateUtil"/>
    </Match>
</FindBugsFilter>
