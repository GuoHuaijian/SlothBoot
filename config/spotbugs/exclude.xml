<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
    <!-- 排除 Lombok 生成的代码 -->
    <Match>
        <Source name="~.*\$.*"/>
    </Match>

    <!-- 全局排除 EI_EXPOSE_REP and EI_EXPOSE_REP2 (Spring 项目普遍存储可变对象引用) -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
    </Match>

    <!-- 排除测试代码 -->
    <Match>
        <Class name="~.*Test$"/>
    </Match>
    <Match>
        <Class name="~.*Tests$"/>
    </Match>
    <Match>
        <Class name="~.*Test\$.*"/>
    </Match>

    <!-- AbstractDecorator: constructor parameter validation throwing is by design -->
    <Match>
        <Bug pattern="CT_CONSTRUCTOR_THROW"/>
        <Class name="com.sloth.boot.common.decorator.AbstractDecorator"/>
    </Match>

    <!-- JsonUtil: shared ObjectMapper singleton is intentional -->
    <Match>
        <Bug pattern="MS_EXPOSE_REP"/>
        <Class name="com.sloth.boot.common.util.JsonUtil"/>
    </Match>

    <!-- Spring ApplicationContext holder: writing static field is standard pattern -->
    <Match>
        <Bug pattern="ST_WRITE_TO_STATIC_FROM_INSTANCE_METHOD"/>
    </Match>

    <!-- TemplateUtil: template property access requires broad exception catch -->
    <Match>
        <Bug pattern="REC_CATCH_EXCEPTION"/>
        <Class name="com.sloth.boot.common.util.TemplateUtil"/>
    </Match>
</FindBugsFilter>
