  "time": { "from": "now-30m", "to": "now" },
  "title": "Sloth JVM Metrics",
  "uid": "sloth-jvm-metrics",
  "version": 2,
  "description": "JVM Monitoring - Memory, Threads, GC, CPU (via OTel Agent -> OTel Collector -> Prometheus)"
